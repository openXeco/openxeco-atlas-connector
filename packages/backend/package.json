{
  "name": "@openxeco/atlas-connector-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "safeclean": "rimraf dist node_modules",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "db:migrate:run": "tsx src/scripts/run-migrations.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4-de6c356",
    "fastify": "5.12.0",
    "ms": "^2.1.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "undici": "7.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/ms": "^2.1.0",
    "@types/node": "^24.13.3",
    "drizzle-kit": "1.0.0-rc.4-ca0f029",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
