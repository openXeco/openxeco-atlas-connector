# ---- PostgreSQL (used by docker-compose) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=atlas_connector

# ---- Backend ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atlas_connector
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ATLAS API
ATLAS_BASE_URL=https://dg-cnect-cybersecurity-atlas.acc.fpfis.tech.ec.europa.eu/jsonapi
ATLAS_API_KEY=your-api-key
ATLAS_USERNAME=your-username
ATLAS_PASSWORD=your-password

# OpenXeco (legacy)
JWT_SECRET_KEY=my_secret_developer_key
OPENXECO_API_ENDPOINT=https://api.example.com/

# ---- Frontend (build-time) ----
# This is baked into the Next.js client bundle at build time.
# For Dokploy: set this to your backend's public URL (e.g. https://api.yourdomain.com)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- General ----
NODE_ENV=development
