# ---- PostgreSQL (used by docker-compose) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=atlas_connector

# ---- Backend ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atlas_connector
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ATLAS API
ATLAS_BASE_URL=atlas-url
ATLAS_API_KEY=api-key-created-in-atlas-environment
ATLAS_USERNAME=shared
ATLAS_PASSWORD=basic-access-auth-2025

# OpenXeco (legacy)
JWT_SECRET_KEY=my_secret_developer_key
OPENXECO_API_ENDPOINT=https://api.example.com/

# ---- Frontend (build-time) ----
# This is baked into the Next.js client bundle at build time.
# For Deployment: set this to your backend's public URL (e.g. https://api.yourdomain.com)
NEXT_PUBLIC_API_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001
BACKEND_INTERNAL_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
# Used to encrypt session in HTTP-only cookie
FRONTEND_SECRET_KEY=your-frontend-secret-key-min-32-chars-change-in-production

# ---- General ----
NODE_ENV=development
