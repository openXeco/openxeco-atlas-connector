# ---- Docker deployment related ----
# This prefix will be used to name the containers in the docker compose stack
# Be sure to adjust all the URL with this name + service
APP_PREFIX=atlas-dev

# ---- PostgreSQL (used by Docker Compose) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=atlas_connector

# ---- Backend ----
# For pnpm dev with the database from docker-compose.yml:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atlas_connector
# For the full Docker Compose stack, use the service hostname and match POSTGRES_PASSWORD:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/atlas_connector

# JWT
JWT_SECRET=your-secret-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ATLAS API
ATLAS_BASE_URL=https://atlas.example.com/jsonapi
ATLAS_API_KEY=api-key-created-in-atlas-environment
ATLAS_USERNAME=demo-username
ATLAS_PASSWORD=demo-password

# Initial administrator created by the local seed:admin command
ADMIN_EMAIL=admin@atlas-connector.local
ADMIN_PASSWORD=admin123456

# OpenXeco (legacy)
JWT_SECRET_KEY=my_secret_developer_key
OPENXECO_API_ENDPOINT=https://api.example.com/

# ---- Frontend ----
# Public backend URL used by the remaining browser-side API client.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server-side backend URL. In the full Compose stack, use http://backend:3001.
BACKEND_INTERNAL_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Set to true in production to avoid potential security issues with unexpected console outputs
NEXT_PUBLIC_DISABLE_CONSOLE=true

# Used to encrypt the HTTP-only session cookie; must be exactly 32 UTF-8 bytes.
FRONTEND_SECRET_KEY=your-secret-key-32-chars--------
FRONTEND_SESSION_COOKIE_NAME=atlas-session

# ---- General ----
NODE_ENV=development
